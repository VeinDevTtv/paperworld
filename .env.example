# Default uses your existing supported local Codex login. Run codex login first.
PAPERWORLD_OPENAI_PROVIDER=codex
# Set only to opt into separately billed OpenAI API calls. Never a fallback.
PAPERWORLD_ALLOW_PAID_API=false
OPENAI_API_KEY=
# For API adapter only: choose a currently documented image-capable structured-output model.
OPENAI_MODEL=
# TypeSafe calls use this server-only key. No credentials are exposed to browsers.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
